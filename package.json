{
  "name": "looprai-csv-export",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "export": "npm run build --silent && node dist/src/index.js",
    "test": "npm run build --silent && jest --runInBand && node --test dist/tests/*.test.js",
    "start": "npm run build --silent && node dist/src/main.js",
    "seed": "npm run build --silent && node dist/scripts/seed.js",
    "test:stage1": "npm run build --silent && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.spec.js"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.22",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "mongoose": "^8.24.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
